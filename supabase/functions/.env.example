# Supabase Edge Functions environment variables
# These are configured in your Supabase project dashboard (Functions > Environment Variables)
#
# Required: Supabase URL + keys are already managed by Supabase runtime when deployed.
# Local development uses `supabase functions serve` which reads from .env.

# Route engine base URL (OSRM-compatible)
# For production: self-host OSRM for Iraq (OSM extract) and point to it.
ROUTING_OSRM_BASE_URL=https://router.project-osrm.org
