# Supabase Edge Functions environment variables (local dev)
# Copy to supabase/.env and fill values if you use Supabase CLI locally.

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=RideIQ

# Optional: model routing per surface
OPENROUTER_MODEL=arcee-ai/trinity-mini:free
OPENROUTER_MODEL_MERCHANT_CHAT=
OPENROUTER_MODEL_MERCHANT=
OPENROUTER_MODEL_DRIVER=
OPENROUTER_MODEL_COPILOT=
OPENROUTER_MODEL_FORMATTER=

# Optional: allowlist (comma-separated)
OPENROUTER_ALLOWED_MODELS=

# Formatter on/off (1 enabled, 0 disabled)
OPENROUTER_ENABLE_FORMATTER=1
